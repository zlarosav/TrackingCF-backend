PORT=3001
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tracking_cf
# Optional administrative database used by npm run db:init/db:delete
DB_ADMIN_DATABASE=postgres
# Set to true when the provider requires TLS
DB_SSL=false

# Codeforces API Credentials (required for user creation/tracking)
API_KEY_CF=
API_SECRET_CF=

# Security (required for admin login tokens)
JWT_SECRET=change_this_to_a_long_random_secret

# Gemini API (optional, only needed for Chat AI)
GEMINI_API_KEY=

# Timezone
TZ=America/Lima

# CORS - Frontend URL (opcional, agregar dominio custom si lo tienes)
# FRONTEND_URL=https://tu-dominio-custom.com
